DOI = {10.1086/303252},
ISSN = {0003-0147},
EISSN = {1537-5323},
Keywords = {model; immigration; plant community; competition for space; species
   diversity; ecosystem processes},
Keywords-Plus = {CORE-SATELLITE HYPOTHESIS; ECOLOGICAL COMMUNITIES; METAPOPULATION
